      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(http_server_requests_seconds_sum{job=~\"$service\", status!~\"5..\"}[1m]) / rate(http_server_requests_seconds_count{job=~\"$service\", status!~\"5..\"}[1m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Latencia Promedio",
      "type": "timeseries"
